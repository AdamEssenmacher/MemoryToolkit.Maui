<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:ShellSample"
             xmlns:mtk="clr-namespace:MemoryToolkit.Maui;assembly=MemoryToolkit.Maui"
             x:Class="ShellSample.MainPage"
             Padding="10"
             Title="Shell Sample"
             mtk:LeakMonitorBehavior.Cascade="True"
             mtk:TearDownBehavior.Cascade="False"
             mtk:TearDownBehavior.Strategy="DisconnectHandlers">

    <Grid RowDefinitions="Auto,*,1,Auto,20,Auto">
        <VerticalStackLayout>
            <Label x:Name="HeapSizeLabel"
                   HorizontalTextAlignment="Center" />
            <Label x:Name="LeakCountLabel"
                   HorizontalTextAlignment="Center" />
            <local:LeakyLabel Text="This label intentionally leaks through an app-level event subscription. In current MAUI, a tiny leaked view is less likely to retain its whole host page, but leaks can still retain strong references such as BindingContext, Content, resources, commands, and event subscriptions. Use leak monitoring to catch the zombie, and opt into Compartmentalize when you need stronger fault containment."
                              HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
        <Grid Grid.Row="1">
            <CollectionView x:Name="ItemsView"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="10" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="local:ListItem">
                        <Border Margin="0,10"
                                HeightRequest="150"
                                StrokeShape="RoundRectangle 10">
                            <Image Source="{Binding ImageUrl}"
                                   Aspect="AspectFill" />
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <!-- <BoxView BackgroundColor="Black" -->
        <!--          Grid.Row="2"/> -->
        <Button Grid.Row="3"
                Text="Push"
                Clicked="Push"
                Margin="0,5,0,0"/>
        <Button Grid.Row="5"
                Text="Pop"
                Clicked="Pop" />
    </Grid>

</ContentPage>
